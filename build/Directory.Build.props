<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SystemTextJsonVersion>8.0.5</SystemTextJsonVersion>
    <OnigwrapVersion>1.0.11</OnigwrapVersion>
    <!-- The GregsEx preview package from feedz.io (NuGet.config); -p:UseGregsExProject=true builds against GregsExProject. -->
    <GregsExVersion Condition="'$(GregsExVersion)' == '' and '$(UseGregsExProject)' != 'true'">0.1.0-preview.24</GregsExVersion>
    <!-- A package depending on a GregsEx preview is itself a prerelease (NU5104). -->
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(GregsExVersion)' != ''">gregsex</VersionSuffix>
    <GregsExProject Condition="'$(GregsExProject)' == ''">$(MSBuildThisFileDirectory)../../gregsex/.claude/worktrees/friendly-zhukovsky-03b73e/src/GregsEx/GregsEx.csproj</GregsExProject>
  </PropertyGroup>
</Project>
