<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- GregsEx preview packages, built from github.com/sebastienros/gregsex main. -->
    <add key="gregsex" value="https://f.feedz.io/sebastienros/gregsex/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="gregsex">
      <package pattern="GregsEx" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
